# NYNU Code Lab root environment template
#
# Docker Compose reads deploy/.env by default in this project.
# This root template is kept as a discoverability index for production readiness checks.
# Copy deploy/.env.example to deploy/.env, then fill every sensitive value before startup.

SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nynu_code_lab
MYSQL_USER=nynu
MYSQL_PASSWORD=
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_PASSWORD=

# Generate with: openssl rand -base64 64
JWT_SECRET=

NGINX_PORT=80

UPLOAD_BASE_PATH=/app/uploads
