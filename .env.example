# ============================================================
# NYNU Code Lab 环境变量模板（根目录索引）
# ============================================================
# Docker Compose 使用 deploy/.env 作为环境变量文件。
# 本文件作为可发现性索引，供生产就绪检查使用。
# 实际部署时请从 deploy/.env.example 复制并填写：
#   cp deploy/.env.example deploy/.env
#   # 编辑 deploy/.env，填写所有敏感值后再启动
# ============================================================
# 注意：deploy/.env 已加入 .gitignore，不会被提交到 Git
# ============================================================

# --- Spring 配置 ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nynu_code_lab
MYSQL_USER=nynu
MYSQL_PASSWORD=
MYSQL_PORT=3306

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- JWT ---
# 生成方式：openssl rand -base64 64
JWT_SECRET=

# --- Nginx ---
NGINX_PORT=80

# --- 文件上传 ---
UPLOAD_BASE_PATH=/app/uploads
