# ============================================================
# NYNU Code Lab Docker Compose 环境变量模板
# 复制此文件为 .env 并修改各配置项：
#   cp .env.example .env
# ============================================================
# 注意：.env 已加入 .gitignore，不会被提交到 Git
# ============================================================

# --- Spring 配置 ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nynu_code_lab
MYSQL_USER=nynu
MYSQL_PASSWORD=
MYSQL_PORT=3306

# --- Redis（预留，当前后端未使用）---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# 生成方式：openssl rand -base64 64
JWT_SECRET=

# --- Nginx ---
NGINX_PORT=80
