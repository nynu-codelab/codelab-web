# ============================================================
# NYNU Code Lab Docker Compose 环境变量模板
# 复制此文件为 .env 并修改各配置项：
#   cp .env.example .env
# ============================================================
# 注意：.env 已加入 .gitignore，不会被提交到 Git
# ============================================================

# --- Spring 配置 ---
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080
BACKEND_PORT=8080

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=nynu_code_lab
MYSQL_USER=nynu
MYSQL_PASSWORD=
MYSQL_PORT=3306

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- JWT ---
# 生成方式：openssl rand -base64 64
JWT_SECRET=

# --- Nginx ---
NGINX_PORT=80
NGINX_SERVER_NAME=localhost

# --- CORS ---
# 多个来源用英文逗号分隔；同源 Nginx 部署可保留 localhost，用独立域名时改为实际 HTTPS 域名。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost

# --- 文件上传 ---
UPLOAD_BASE_PATH=/app/uploads
